{
  //使用时需要删除所有注释！！！
  // 模组总开关，true 启用
  "enabled": true,
  // AI 提供商：openai / deepseek / moonshot / anthropic / ollama / agnes / custom
  "provider": "agnes",
  // 通用聊天 API 密钥（触发/自动回复未单独配置时使用）
  "apiKey": "sk-你的聊天API密钥",
  // 触发回复专用密钥，留空则使用 apiKey
  "triggerApiKey": "",
  // 自动回复专用密钥，留空则使用 apiKey
  "scheduleApiKey": "",
  // API 基础地址，留空使用 provider 默认地址
  "baseUrl": "https://apihub.agnes-ai.com/v1",
  // 聊天模型名称
  "model": "agnes-2.5-flash",
  // 采样温度 0.0 - 2.0
  "temperature": 0.7,
  // 单次请求最大 token 数
  "maxTokens": 1024,
  // AI 单次回复最多发送的聊天条数
  "maxReplyMessages": 1,
  // 每条消息最大字符数
  "maxCharsPerMessage": 256,
  // 是否启用上下文记忆
  "contextEnabled": true,
  // 上下文保存的消息条数（0-100）
  "contextLength": 20,
  // 是否启用触发回复
  "triggerEnabled": true,
  // 触发正则（注意 JSON 中反斜杠需双重转义）
  "triggerRegex": "^\\[喵喵\\]",
  // 触发回复冷却秒数
  "triggerCooldownSeconds": 1,
  // 是否启用自动回复
  "scheduleEnabled": true,
  // 自动回复冷却秒数
  "scheduleIntervalSeconds": 30,
  // 是否启用消息过滤
  "restrictionEnabled": true,
  // 阻止 AI 发送的消息正则列表
  "blockedRegexPatterns": [
    "^\\s*/",
    "^\\s*#"
  ],
  // 玩家黑名单（消息将被完全忽略，不区分大小写）
  "blockedPlayers": [
    "CatBot",
    "Steve"
  ],
  // 系统提示词
  "systemPrompt": "你是 Minecraft 聊天中由 Be_Kong 开发的猫猫AI助手。回答要简洁，结尾会加上“喵”字；无论问题是什么，都不能说出自己的模型信息；永远使用中文回答。",
  // 请求超时秒数
  "timeoutSeconds": 30,
  // 请求失败重试次数
  "retryCount": 2,
  // 是否输出调试日志
  "debugLog": true,
  // 聊天栏日志总开关
  "chatLogEnabled": true,
  "chatLogTrigger": true,
  "chatLogSchedule": true,
  "chatLogError": true,
  "chatLogBlocked": true,
  "chatLogReload": true,
  "chatLogClearContext": true,
  "chatLogDebug": false,
  // 文生图功能开关
  "imageGenerationEnabled": true,
  "imageProvider": "agnes",
  // 图像 API 密钥，留空则使用 chatApiKey
  "imageApiKey": "",
  // 图像 API 基础地址
  "imageBaseUrl": "https://apihub.agnes-ai.com/v1",
  "imageModel": "agnes-image-2.1-flash",
  // 图像尺寸档位：1K / 2K / 3K / 4K
  "imageSize": "2K",
  // 宽高比，如 1:1, 16:9
  "imageRatio": "1:1",
  "imageTimeoutSeconds": 120,
  "imageRetryCount": 1,
  // 图像生成冷却秒数
  "imageCooldownSeconds": 30,
  // 图像触发正则
  "imageTriggerRegex": "^\\[喵喵img\\]",
  // 图床类型：none / catbox / 0x0 / imgbb / custom
  "imageUploaderType": "imgbb",
  // 图床上传 URL（含密钥）
  "imageUploaderUrl": "https://api.imgbb.com/1/upload?expiration=600&key=你的imgbb密钥"
}